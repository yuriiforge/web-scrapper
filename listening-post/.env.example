# Copy to .env for running apps outside Docker (npm run dev:*).
DATABASE_URL=postgres://lp:lp@localhost:5432/listening_post
SOURCE_BASE_URL=http://localhost:4000
API_PORT=3001
WORKER_CONCURRENCY=4
THREADIT_CLIENT_ID=dev-id
THREADIT_CLIENT_SECRET=dev-secret
API_URL=http://localhost:3001
LOG_LEVEL=info
TRUTH_URL=http://localhost:4000/_admin/truth

# Access. The API needs API_TOKEN on every /api request; the dashboard needs ADMIN_PASSWORD to sign in.
# Leave them empty to turn the checks off while developing locally.
API_TOKEN=dev-api-token-change-me
ADMIN_PASSWORD=admin
SESSION_SECRET=dev-session-secret-change-me

# Claude scoring (worker). Without a key only the free rules scorer runs. LLM_MONTHLY_USD caps model spend
# per calendar month; the LLM_*_USD_PER_MTOK prices (defaults: Claude Opus 5.5) feed the cost ledger.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MONTHLY_USD=5
LLM_MAX_ITEMS_PER_PASS=100
LLM_BATCH_SIZE=25
